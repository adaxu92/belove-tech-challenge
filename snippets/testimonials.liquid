
{%- for block in blocks -%}
{%- liquid
  if section.settings.content_mode
    assign block_image = block.image.value
    assign block_name = block.name.value
    assign block_title = block.title.value
    assign block_body = block.body.value
    assign block_rating = block.rating.value
  else 
    assign block_image = block.settings.image
    assign block_name = block.settings.name
    assign block_title = block.settings.title
    assign block_body = block.settings.body_copy
    assign block_rating = block.settings.star_rating  
  endif 
-%}
  <li class="testimonials__card splide__slide">
    <div class="testimonials__customer">
      {%- if block_image -%}
      {{
        block_image
        | image_url: width: 200
        | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
      }}
      {%- else -%}
        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <circle cx="12" cy="10" r="3" fill="currentColor"/>
          <path d="M7 18C7 15.7909 8.79086 14 11 14H13C15.2091 14 17 15.7909 17 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      {%- endif -%}
      <div class="testimonials__customer-content">
        <h4>{{ block_name }}</h4>
        <h5>{{ block_title }}</h5>
      </div>
    </div>
    <div class="testimonials__star">
      {%- assign ratings = block_rating -%}
      {%- for i in (1..5) -%}
        {%- if forloop.index <= ratings -%}
          <svg width="24" height="24" viewBox="0 0 100 100">
            <polygon points="50,5 63,38 98,38 70,60 81,95 50,74 19,95 30,60 2,38 37,38" fill="#FFD700" />
          </svg>
        {%- else -%}
          <svg width="24" height="24" viewBox="0 0 100 100">
            <polygon points="50,5 63,38 98,38 70,60 81,95 50,74 19,95 30,60 2,38 37,38" fill="#FFF" stroke="#FFD700" stroke-width="4" />
          </svg>
        {%- endif-%}
      {%- endfor -%}
    </div>
    <blockquote>{{ block_body | prepend: '&quot;' | append: '&quot;'  }}</blockquote>
  </li>
{%- endfor -%}